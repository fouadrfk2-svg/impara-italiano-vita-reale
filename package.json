{
  "name": "impara-italiano",
  "version": "2.0.0",
  "private": true,
  "description": "Static Italian learning frontend with an optional server-only Vercel API foundation.",
  "homepage": "https://andreabonn.github.io/impara-italiano/",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:dom": "playwright test",
    "test:mutations": "node scripts/mutations.mjs",
    "test:all": "npm test && npm run test:mutations && npm run test:dom",
    "coverage": "node scripts/coverage.mjs",
    "validate": "node scripts/validate.mjs",
    "parity": "node scripts/parity.mjs",
    "check:precache": "node scripts/check_precache.mjs",
    "check:swversion": "node scripts/check_swversion.mjs",
    "lint": "eslint .",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build-static.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0"
  }
}
